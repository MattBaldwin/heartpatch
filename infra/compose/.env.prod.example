# Production settings for the server (tech spec §10). On the server this file
# is /opt/heartpatch/.env, owned by the deploy user, mode 600. It holds secrets:
# never commit it, paste it into chat, or put it in GitHub.
#
# Generate each secret ON THE SERVER and paste it in (docs/DEPLOY.md step 6):
#   openssl rand -hex 32        # POSTGRES_PASSWORD
#   tr -dc a-km-np-z2-9 </dev/urandom | head -c 10; echo   # HP_SIGNUP_CODE: short to type
#     on a phone, no look-alike letters (l/1, 0/o); the auth rate limit stops guessing

# --- Database ----------------------------------------------------------------
# Password for the `heartpatch` Postgres user. Use the hex command above: it
# only has URL-safe characters, so it can go straight into DATABASE_URL.
# Changing it later needs an ALTER USER too (docs/DEPLOY.md, "Troubleshooting").
POSTGRES_PASSWORD=
# Leave unset: compose builds postgres://heartpatch:<POSTGRES_PASSWORD>@db:5432/heartpatch.
# DATABASE_URL=

# --- Server ------------------------------------------------------------------
# The address players use. Cookies and CORS are locked to it.
PUBLIC_ORIGIN=https://play.pumpkinpatchgames.com
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Family-only signup (Phase 1): needed to create an account. Share it with
# your family in person; change it here (and redeploy) if it leaks.
HP_SIGNUP_CODE=
# Evolution roll salt: generated by deploy.sh on first deploy; never change it
# once set (it changes evolution rolls); back it up with .env.
HP_EVOLUTION_SALT=
# true: new accounts finish "The First Patch" before creating/joining a map
# (owner decision 2026-10-04). false lets them skip it (turn off only if the
# tutorial misbehaves; restart to apply).
HP_TUTORIAL_REQUIRED=true
# Default true: creating or joining a map needs a Keeper. Only set false for testing.
# HP_KEEPER_REQUIRED=true
# The Keeper's house (#381): off until the owner's go/no-go. `testers` shows it
# only to the usernames in HP_HOUSE_TESTERS (comma-separated); `on` to everyone.
# Restart to apply.
HP_HOUSE=off
# HP_HOUSE_TESTERS=
# Wild Isle (#621), the second patch type: `on` lets everyone choose it when
# they make a patch (owner decision 2026-10-30: on for Halloween). `testers`
# offers it only to the usernames in HP_WILD_ISLE_TESTERS; `off` hides it.
# Existing patches never change. Restart to apply.
HP_WILD_ISLE=on
# HP_WILD_ISLE_TESTERS=
# The Long Night (#727): `off` runs every nightfall as an ordinary night.
# `testers` runs it only on patches with a member named in
# HP_LONG_NIGHT_TESTERS; `on` on every patch (owner decision 2026-10-31: on
# for everyone). The prod compose file defaults it to `on`; a line here wins.
# Restart to apply.
HP_LONG_NIGHT=on
# HP_LONG_NIGHT_TESTERS=
# Push nudges (#726): off until the client lane (#726e) passes the real-phone
# test. `testers` nudges only the usernames in HP_PUSH_TESTERS
# (comma-separated); `on` everyone who says yes. Restart to apply.
HP_PUSH=off
# HP_PUSH_TESTERS=
# The VAPID key pair push services check every nudge against: generated by
# deploy.sh on the first deploy. Never change them once set (that ends every
# phone's nudges until each one subscribes again); back them up with .env.
HP_VAPID_PUBLIC_KEY=
HP_VAPID_PRIVATE_KEY=
# Who push services can contact: a mailto: or https: URL. Unset uses PUBLIC_ORIGIN.
# HP_VAPID_SUBJECT=
# The site name Caddy serves and gets a certificate for. Leave unset in production.
# HP_SITE_ADDRESS=play.pumpkinpatchgames.com

# --- Set by the stack, not here -----------------------------------------------
# docker-compose.prod.yml fixes these, so values here are ignored:
#   NODE_ENV=production  PORT=3000  TRUST_PROXY=true (Caddy is the one proxy)
#   APP_VERSION=<image tag>
# HP_DEV_NOW is dev/test only. Never set it in production.

# --- Managed by deploy.sh -------------------------------------------------------
# The image tag (commit SHA) currently deployed. deploy.sh rewrites this line;
# don't edit it by hand except when following the rollback steps in DEPLOY.md.
HEARTPATCH_TAG=
