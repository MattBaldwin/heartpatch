# Production settings for the server (tech spec §10). On the server this file
# is /opt/heartpatch/.env, owned by the deploy user, mode 600. It holds secrets:
# never commit it, paste it into chat, or put it in GitHub.
#
# Generate each secret ON THE SERVER and paste it in (docs/DEPLOY.md step 6):
#   openssl rand -hex 32        # POSTGRES_PASSWORD
#   openssl rand -base64 64 | tr -d '\n'; echo   # SESSION_SECRET
#   tr -dc a-km-np-z2-9 </dev/urandom | head -c 10; echo   # HP_SIGNUP_CODE: short to type
#     on a phone, no look-alike letters (l/1, 0/o); the auth rate limit stops guessing

# --- Database ----------------------------------------------------------------
# Password for the `heartpatch` Postgres user. Use the hex command above: it
# only has URL-safe characters, so it can go straight into DATABASE_URL.
# Changing it later needs an ALTER USER too (docs/DEPLOY.md, "Troubleshooting").
POSTGRES_PASSWORD=
# Leave unset: compose builds postgres://heartpatch:<POSTGRES_PASSWORD>@db:5432/heartpatch.
# DATABASE_URL=

# --- Server ------------------------------------------------------------------
# Signs session cookies. 64 random bytes, base64. Changing it logs everyone out.
SESSION_SECRET=
# The address players use. Cookies and CORS are locked to it.
PUBLIC_ORIGIN=https://play.pumpkinpatchgames.com
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Family-only signup (Phase 1): needed to create an account. Share it with
# your family in person; change it here (and redeploy) if it leaks.
HP_SIGNUP_CODE=
# false: new accounts can create/join maps before finishing the tutorial.
# Flip to true once the tutorial (#24) ships.
HP_TUTORIAL_REQUIRED=false
# The site name Caddy serves and gets a certificate for. Leave unset in production.
# HP_SITE_ADDRESS=play.pumpkinpatchgames.com

# --- Set by the stack, not here -----------------------------------------------
# docker-compose.prod.yml fixes these, so values here are ignored:
#   NODE_ENV=production  PORT=3000  TRUST_PROXY=true (Caddy is the one proxy)
#   APP_VERSION=<image tag>
# HP_DEV_NOW is dev/test only. Never set it in production.

# --- Managed by deploy.sh -------------------------------------------------------
# The image tag (commit SHA) currently deployed. deploy.sh rewrites this line;
# don't edit it by hand except when following the rollback steps in DEPLOY.md.
HEARTPATCH_TAG=
