{
  "name": "heartpatch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"pnpm --filter @heartpatch/server dev\" \"pnpm --filter @heartpatch/client dev\"",
    "build": "pnpm -r build && node scripts/check-client-bundle.mjs",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @heartpatch/client test:e2e",
    "sim": "pnpm --filter @heartpatch/shared sim",
    "sim:progression": "pnpm --filter @heartpatch/shared sim:progression",
    "sim:map-fill": "pnpm --filter @heartpatch/shared sim:map-fill",
    "sim:fuel": "pnpm --filter @heartpatch/shared sim:fuel",
    "sim:costumes": "pnpm --filter @heartpatch/shared sim:costumes",
    "lint": "eslint . --max-warnings 0 && node scripts/check-filenames.mjs && node scripts/check-procedural-rules.mjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/compose/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @heartpatch/server db:generate",
    "db:check": "pnpm --filter @heartpatch/server db:check",
    "db:migrate": "pnpm --filter @heartpatch/server db:migrate",
    "db:seed": "pnpm --filter @heartpatch/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
