{
  "name": "@heartpatch/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --conditions=@heartpatch/source --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && prettier --write --log-level warn src/db/migrations",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --conditions=@heartpatch/source --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "NODE_ENV=development tsx --conditions=@heartpatch/source --env-file-if-exists=../../.env src/db/cli.ts seed"
  },
  "dependencies": {
    "@heartpatch/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
