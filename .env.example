# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:5173
# Set by the deploy pipeline (image tag); shown in /api/v1/health.
APP_VERSION=dev
# true behind Caddy in production so request.ip is the player's IP.
TRUST_PROXY=false
