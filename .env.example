# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:5173
# Set by the deploy pipeline (image tag); shown in /api/v1/health.
APP_VERSION=dev
# true behind Caddy in production so request.ip is the player's IP.
TRUST_PROXY=false
# Local Postgres from `pnpm db:up` (infra/compose/docker-compose.dev.yml).
DATABASE_URL=postgres://heartpatch:heartpatch@localhost:5432/heartpatch
# Family signup code (decision D): required to create an account. Required in
# production (use a long random string); leave unset to close signups.
HP_SIGNUP_CODE=heartpatch-dev-family
# Tutorial gate (decision A): true makes players finish the tutorial before
# creating or joining a map. Keep false until the tutorial ships.
HP_TUTORIAL_REQUIRED=false
# Keeper gate (#42): true makes new players pick a Keeper before creating or
# joining a map. Leave true.
HP_KEEPER_REQUIRED=true
# Dev time override (development/tests only): the game clock starts here, e.g.
# 2026-12-20T20:59:00-05:00 to try nightfall. Leave unset normally.
# HP_DEV_NOW=
# Dev/e2e only: raises the per-IP signup limit (Playwright sets it for its server).
# HP_DEV_SIGNUP_LIMIT_PER_IP=500
# Dev/e2e only: routes that hand a player a squishy and pick a fight with a
# wild squishy, until spawns (#14) and the tutorial's starter exist. Refused in
# production (Playwright sets it). Uncomment to try battles on your phone.
# HP_DEV_SQUISHY_GRANTS=true
# Dev/e2e only: every found-clothing drop chance, in percent (#43), so a gather
# finds something. Refused in production. Try 100 to see a find on your phone.
# HP_DEV_DROP_CHANCE=100
