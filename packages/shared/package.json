{
  "name": "@heartpatch/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@heartpatch/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@heartpatch/source": "./src/data/server/index.ts",
      "types": "./dist/data/server/index.d.ts",
      "default": "./dist/data/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.include='src/battle/**' --coverage.include='src/rng/**' --coverage.thresholds.100=false --coverage.thresholds.lines=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
